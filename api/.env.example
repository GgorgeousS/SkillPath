# Строка подключения к PostgreSQL (обязательно).
# Локально через docker compose (см. docker-compose.yml в корне проекта):
DATABASE_URL=postgresql://skillpath:skillpath@127.0.0.1:5432/skillpath

# Origins, которым разрешены запросы из браузера (через запятую).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Сколько регистраций в час разрешено с одного IP (защита от массового создания аккаунтов).
REGISTER_LIMIT_PER_HOUR=20
