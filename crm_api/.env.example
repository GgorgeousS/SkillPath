# CRM API config
# 1) Generate a random API key and paste it here
CRM_API_KEY=PASTE_RANDOM_API_KEY_HERE

# Comma-separated list of allowed origins for browser requests.
# For local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Optional: override database path (defaults to ./crm.db)
# CRM_DB_PATH=crm.db


# ===== Bitrix24 integration (optional) =====
# If BITRIX_WEBHOOK_URL is set, backend will create a Contact via REST method crm.contact.add
# Webhook example:
# BITRIX_WEBHOOK_URL=https://<your-portal>.bitrix24.<tld>/rest/<user_id>/<webhook_code>

# Enable Bitrix24 integration (leave empty to disable)
BITRIX_WEBHOOK_URL=

# Optional: override "Source" written into UF_SOURCE
# BITRIX_SOURCE=SkillPath Form

# Optional: assign responsible user for created Contact
# BITRIX_ASSIGNED_BY_ID=123

# Optional: override UF_* field codes (if your Bitrix custom field codes differ)
# BITRIX_UF_PERSONA_TYPE=UF_PERSONA_TYPE
# BITRIX_UF_INTERESTS=UF_INTERESTS
# BITRIX_UF_SKILLS=UF_SKILLS
# BITRIX_UF_RECOMMENDED_DIRECTIONS=UF_RECOMMENDED_DIRECTIONS
# BITRIX_UF_ASSESSMENT_RESULT=UF_ASSESSMENT_RESULT
# BITRIX_UF_SOURCE=UF_SOURCE
# BITRIX_UF_CREATED_AT=UF_CREATED_AT
